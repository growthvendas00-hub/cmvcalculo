# ─── Banco de dados (somente na Vercel) ─────────────────────────────
# Crie um banco Upstash (KV) no painel da Vercel — Storage > Create Database.
# A Vercel injeta estas variáveis automaticamente. Não precisa colar à mão
# se você conectar o banco ao projeto pela própria Vercel.
#
# Localmente NÃO defina nada: sem estas variáveis, o sistema grava em /data.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# (Alternativa, se usar Upstash direto em vez do KV da Vercel)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── WhatsApp (Meta WhatsApp Cloud API) ─────────────────────────────
# Token que VOCÊ inventa; o mesmo valor é colado na config do webhook na Meta.
WHATSAPP_VERIFY_TOKEN=cmv-studio
# Token de acesso gerado no painel da Meta (para o sistema responder no Whats).
WHATSAPP_TOKEN=
# (Recomendado) App Secret da Meta — valida a assinatura das requisições.
WHATSAPP_APP_SECRET=
# (Recomendado) Números autorizados a registrar, separados por vírgula (só dígitos, com DDI).
# Ex.: 5511999999999,5511888888888
WHATSAPP_ALLOWED=
