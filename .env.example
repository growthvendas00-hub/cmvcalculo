# ─── Banco de dados (somente na Vercel) ─────────────────────────────
# Crie um banco Upstash (KV) no painel da Vercel — Storage > Create Database.
# A Vercel injeta estas variáveis automaticamente. Não precisa colar à mão
# se você conectar o banco ao projeto pela própria Vercel.
#
# Localmente NÃO defina nada: sem estas variáveis, o sistema grava em /data.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# (Alternativa, se usar Upstash direto em vez do KV da Vercel)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
